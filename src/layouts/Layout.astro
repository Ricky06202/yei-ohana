---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css'
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/png" href="/game/CosmicHeart.icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>El Mapa Estelar de Nuestra Ohana 🌌</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400..700&family=Inter:wght@400;700&family=Sacramento&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body class="bg-[#0f0416] text-white selection:bg-pink-500/30 min-h-screen">
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --space-dark: #0f0416;
    --space-purple: #2d1b4e;
    --angel-pink: #ff4d94;
    --angel-lila: #d4a5ff;
  }

  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle at center,
      var(--space-purple) 0%,
      var(--space-dark) 100%
    );
  }

  .font-handwritten {
    font-family: 'Caveat', cursive;
  }

  .font-romantic {
    font-family: 'Sacramento', cursive;
  }
</style>
