---
import Layout from '../layouts/Layout.astro';
import { ChevronLeft, Gamepad2, MousePointer2, Heart } from 'lucide-react';
---

<Layout>
  <main class="min-h-screen w-full bg-[#0f0416] flex flex-col items-center p-4 md:p-8 relative overflow-x-hidden">
    <!-- Botón Volver -->
    <a 
      href="/#mapa" 
      class="absolute top-6 left-6 flex items-center gap-2 text-pink-200 hover:text-pink-400 transition-colors z-50 group"
    >
      <div class="bg-pink-500/20 p-2 rounded-full group-hover:bg-pink-500/40 transition-all">
        <ChevronLeft size={24} />
      </div>
      <span class="font-handwritten text-2xl">Volver al mapa</span>
    </a>

    <!-- Header del Juego -->
    <div class="mt-16 md:mt-8 mb-8 text-center animate-fade-in" transition:name="hero-title">
      <div class="flex justify-center mb-4">
        <img 
          src="/game/CosmicHeart.icon.png" 
          alt="Cosmic Heart Icon" 
          class="w-20 h-20 md:w-32 md:h-32 rounded-2xl shadow-[0_0_20px_rgba(255,77,148,0.5)] animate-bounce"
          style="animation-duration: 3s;"
        />
      </div>
      <h1 class="text-5xl md:text-7xl font-romantic text-pink-300 drop-shadow-[0_0_15px_rgba(255,77,148,0.6)] mb-4">
        Cosmic Heart
      </h1>
      <p class="text-xl md:text-2xl font-handwritten text-purple-200 opacity-90 max-w-md mx-auto leading-tight">
        Un pequeño regalo hecho en Godot para que sigas transformando el universo con tu luz. ✨
      </p>
    </div>

    <!-- Contenedor Principal: Juego + Instrucciones -->
    <div class="w-full max-w-6xl flex flex-col lg:flex-row gap-8 items-center justify-center flex-grow">
      
      <!-- Instrucciones (Izquierda en Desktop) -->
      <div class="w-full lg:w-1/3 space-y-6 order-2 lg:order-1">
        <div class="bg-white/5 backdrop-blur-md border border-pink-500/30 p-6 rounded-2xl shadow-[0_0_30px_rgba(255,77,148,0.1)]">
          <div class="flex items-center gap-3 mb-4 text-pink-300">
            <Gamepad2 size={28} />
            <h2 class="text-3xl font-handwritten">¿De qué trata?</h2>
          </div>
          <p class="text-purple-100 text-lg leading-relaxed font-light mb-6">
            Eres un pequeño <span class="text-pink-300 font-bold">robot espacial</span> con una misión especial: 
            purificar las nubes oscuras con tus destellos rosas para transformarlas en <span class="text-pink-300 font-bold">cristales de memoria</span>.
          </p>

          <div class="space-y-4">
            <div class="flex items-start gap-4">
              <div class="bg-pink-500/20 p-2 rounded-lg text-pink-300 shrink-0">
                <Heart size={20} />
              </div>
              <p class="text-purple-200 text-base">Al conseguir <span class="text-white font-bold">10 cristales</span>, desbloquearás una memoria especial.</p>
            </div>
            <div class="flex items-start gap-4">
              <div class="bg-pink-500/20 p-2 rounded-lg text-pink-300 shrink-0">
                <Heart size={20} />
              </div>
              <p class="text-purple-200 text-base">Tienes <span class="text-white font-bold">3 vidas</span>. Si una nube es muy difícil, puedes dejarla pasar.</p>
            </div>
            <div class="flex items-start gap-4">
              <div class="bg-pink-500/20 p-2 rounded-lg text-pink-300 shrink-0">
                <MousePointer2 size={20} />
              </div>
              <p class="text-purple-200 text-base">Controles: <span class="text-white font-bold">Arrastra al robot con tu dedo</span> por la pantalla.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- El Juego (Centro) -->
      <div class="w-full max-w-[400px] aspect-[9/16] bg-black rounded-3xl overflow-hidden border-4 border-pink-500/50 shadow-[0_0_50px_rgba(255,77,148,0.3)] relative order-1 lg:order-2">
        <iframe 
          src="/game/CosmicHeart.html" 
          class="w-full h-full border-none"
          title="Cosmic Heart Game"
          allow="autoplay; focus-without-user-activation"
        ></iframe>
      </div>

      <!-- Espacio decorativo (Derecha en Desktop) -->
      <div class="hidden lg:block lg:w-1/3 order-3">
         <div class="animate-pulse opacity-20">
            <Heart size={200} className="text-pink-500 mx-auto" />
         </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @keyframes fade-in {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in {
    animation: fade-in 0.8s ease-out forwards;
  }
</style>
