{
	"main": "dist/_worker.js/index.js",
	"name": "yei-ohana",
	"compatibility_date": "2026-02-07",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"bucket_name": "yei-ohana-bucket",
			"binding": "yei_ohana_bucket",
			"remote": true
		}
	]
}